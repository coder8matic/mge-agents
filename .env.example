# Kopiraj v .env in izpolni. .env NIKOLI v git.

# --- Postgres ---
POSTGRES_PASSWORD=spremeni-me-dolgo-geslo

# --- Anthropic (Console -> workspace "mge-agents" -> API key) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Executor (web UI http://localhost:4788 -> ključ za MCP odjemalce) ---
EXECUTOR_VERSION=latest
EXECUTOR_TOKEN=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_APPROVAL_CHANNEL_ID=
DISCORD_APPROVER_IDS=        # tvoj Discord user ID; več ID-jev loči z vejico

# --- Odoo 19 ---
ODOO_URL=https://tvoje-podjetje.odoo.com
ODOO_DB=tvoja-baza
ODOO_AGENT_USER_ID=          # ID uporabnika "Invoicing Agent"
ODOO_AGENT_API_KEY=          # API ključ uporabnika "Invoicing Agent" (samo osnutki)
ODOO_APPROVER_API_KEY=       # API ključ uporabnika z pravico knjiženja (ti)
