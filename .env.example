# Copy to .env and fill in. NEVER commit .env to git.

# --- Postgres ---
POSTGRES_PASSWORD=change-me-long-password

# --- Claude subscription (Pro/Max): token from `claude setup-token` ---
# Do NOT set ANTHROPIC_API_KEY, it takes precedence over the subscription token.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# --- Executor (web UI http://localhost:4788 -> key for MCP clients) ---
EXECUTOR_VERSION=latest
EXECUTOR_TOKEN=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_APPROVAL_CHANNEL_ID=
DISCORD_APPROVER_IDS=        # your Discord user ID; separate multiple IDs with commas

# --- Odoo 19 ---
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-database
ODOO_AGENT_USER_ID=          # ID of the "Invoicing Agent" user
ODOO_AGENT_API_KEY=          # API key of the "Invoicing Agent" user (drafts only)
ODOO_APPROVER_API_KEY=       # API key of a user allowed to post invoices (you)
